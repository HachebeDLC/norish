  Input: ({ value, onValueChange, isReadOnly, isDisabled }: any) => (
    <input
      disabled={isDisabled}
      readOnly={isReadOnly}
      value={value}
      onChange={(event) => onValueChange?.(event.target.value)}
    />
  ),
