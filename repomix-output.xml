    providers: data?.providers ?? [],
    registrationEnabled: data?.registrationEnabled ?? false,
    passwordAuthEnabled: data?.passwordAuthEnabled ?? false,
    isLoading: query.isLoading,
    error: query.error,
    refetch: query.refetch,
    hasData: !!data,
  };
}
