describe("Auth Provider Sync Logic", () => {
  beforeEach(() => {
    vi.clearAllMocks();
    mockServerConfig = {};
    mockDeleteConfig.mockResolvedValue(undefined);
  });

  afterEach(() => {
    vi.resetModules();
