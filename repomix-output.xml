      const file = new File(["test"], "test.jpg", { type: "image/jpeg" });

      formData.append("image", file);

      expect(formData.get("image")).toBeDefined();
      expect(formData.get("image")).toBeInstanceOf(File);
    });

    it("validates file type", () => {
