              <div className="flex items-center gap-2">
                {currentTab === "admin" ? (
                  <ShieldCheckIconSolid className="h-5 w-5" />
                ) : (
                  <ShieldCheckIconOutline className="h-5 w-5" />
                )}
                <span>{t("tabs.admin")}</span>
              </div>
            }
          >
            <div className="py-4">
              <AdminSettingsTab />
            </div>
          </Tab>
        )}
