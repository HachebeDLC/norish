            manufacturer="Bring! Labs AG",
            model="Bring! Grocery Shopping List",
            configuration_url=f"https://web.getbring.com/app/lists/{list(self.coordinator.lists).index(bring_list)}"
            if bring_list in self.coordinator.lists
            else None,
        )
