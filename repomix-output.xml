      and(
        eq(caldavSyncStatus.userId, userId),
        inArray(caldavSyncStatus.syncStatus, ["pending", "failed"])
      )
    );

  return rows.map((row) => {
    const validated = CaldavSyncStatusSelectSchema.safeParse(row);

