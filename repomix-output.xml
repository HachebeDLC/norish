      await waitFor(() => {
        expect(result.current.isLoading).toBe(false);
      });

      expect(result.current.user).toEqual(mockUser);
      expect(result.current.apiKeys).toEqual(mockApiKeys);
    });

    it("handles fetch failure gracefully", async () => {
