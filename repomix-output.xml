import { AuthLocaleMenu } from '@/components/shell/auth-locale-menu';

export default function AuthLayout() {
  return (
    <Stack
      screenOptions={{
        headerShown: true,
        headerTransparent: Platform.OS === 'ios',
        headerShadowVisible: false,
        headerTitle: '',
        headerRight: () => <AuthLocaleMenu />,
