  createMockApiKey,
  createMockAuthedContext,
  createMockHousehold,
  createMockUser,
} from "./test-utils";

// Setup mocks before any imports that use them
vi.mock("@norish/db", () => import("../mocks/user-repository"));
vi.mock("@norish/config/env-config-server", () => ({
  SERVER_CONFIG: {
    UPLOADS_DIR: "/tmp/uploads",
  },
}));
