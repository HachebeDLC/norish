    alignItems: 'center',
    justifyContent: 'center',
    flexShrink: 0,
  },
  stepNumberText: {
    fontSize: 14,
    fontWeight: '700',
  },
  stepContent: {
    flex: 1,
    gap: 10,
  },
  stepContentDone: {
    opacity: 0.5,
  },
  stepText: {
    fontSize: 15,
    lineHeight: 22,
  },
  stepTextDone: {
    textDecorationLine: 'line-through',
  },
  imageRow: {
    flexDirection: 'row',
    gap: 8,
    flexWrap: 'wrap',
  },
  imageThumbnail: {
    width: 64,
    height: 64,
    borderRadius: 10,
    overflow: 'hidden',
    borderWidth: 1,
  },
  imageThumbnailPressed: {
    opacity: 0.7,
    transform: [{ scale: 0.95 }],
  },
  imageThumbnailDone: {
    opacity: 0.4,
  },
  imageBadge: {
    position: 'absolute',
    bottom: 4,
    right: 4,
    borderRadius: 8,
    paddingHorizontal: 5,
    paddingVertical: 1,
    minWidth: 18,
    alignItems: 'center',
  },
  imageBadgeText: {
